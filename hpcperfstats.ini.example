# Copy to hpcperfstats.ini — see README Installation (cp hpcperfstats.ini.example hpcperfstats.ini).

[DEFAULT]
# Short cluster name (used in RMQ queue and host_name_ext interpolation).
machine = cluster_name

# FQDN suffix for node dirs under archive_dir (dirname must end with this string).
host_name_ext = %(machine)s.domain.edu

# Root directory for HPCPerfStats file data (archive, accounting, logs).
data_dir = /hpcperfstats/

# Comma-separated FQDNs for the web/proxy host (TLS allowlist and Django ALLOWED_HOSTS).
server = servername.domain.edu, stats.cluster.domain.edu

# Queue name substrings that exclude jobs from listings (Python list syntax).
restricted_queue_keywords = ['secure', 'secret']

# Verbose logging in container logs (yes/true/1 or no).
debug = True

# Email domain suffix marking staff users who can see all jobs.
staff_email_domain = lab.hpcisgreat.edu

# IANA timezone for Django and cluster time alignment.
timezone = America/Chicago

# Django SECRET_KEY; set a long random value in production.
secret_key = change-me-to-a-long-random-string

# Ini cap on parallel workers (effective cores = min(this, os.cpu_count()); default 40).
# total_cores = 40

# Django database engine backend.
engine_name = django.db.backends.postgresql

# PostgreSQL database name.
dbname = hpcperfstats

# PostgreSQL username.
username = hpcperfstats

# PostgreSQL password.
password = hpcperfstats

# PostgreSQL host (compose service name in default install).
host = db

# PostgreSQL port.
port = 5432

[OAUTH2]
# OAuth2 client id from your identity provider.
client_id =

# OAuth2 client secret.
client_key =

# Tenant base URL for token and API calls.
oauth_base_url = https://tacc.tapis.io/v3

# Browser authorization URL template (uses client_id and redirect placeholders).
authorize_url = %(oauth_base_url)s/oauth2/authorize?client_id=%(client_id)s&redirect_uri=%%s&response_type=code&state=%%s

[RMQ]
# RabbitMQ hostname (compose service name in default install).
rmq_server = rabbitmq

# Queue name for monitor payloads (interpolates machine).
rmq_queue = %(machine)s

[SYSLOG]
# Comma-separated IPv4 CIDRs allowed on port 514; empty allows all IPv4.
# allow_from = 10.0.0.0/8, 192.168.50.0/24

# Listen for remote syslog on TCP 514 (default yes).
# listen_tcp = yes

# Listen for remote syslog on UDP 514 (default yes).
# listen_udp = yes

[PORTAL]
# http or https for CORS origins built from server when debug is off (default https).
# cors_origin_scheme = https

# Absolute Gunicorn worker count when WEB_CONCURRENCY is unset (default 32).
# gunicorn_workers = 32

# Nested summary-plot aggregate prefetch thread ceiling (default 2).
# summary_aggregate_prefetch_max_threads = 2

# Max threads for API prefetch and default small executor (default 4).
# parallel_db_prefetch_max = 4

# Override API ThreadPoolExecutor size; else parallel_db_prefetch_max (default 4).
# api_small_executor_max_workers = 4

# Django CONN_MAX_AGE seconds; env DJANGO_CONN_MAX_AGE overrides (default 90).
# db_conn_max_age = 90

# PostgreSQL statement_timeout ms per session; 0 omits (default 120000).
# db_statement_timeout_ms = 120000

# PostgreSQL idle_in_transaction_session_timeout ms; 0 omits (default 300000).
# db_idle_in_transaction_session_timeout_ms = 300000

# Development-only hidden test-login; default no.
# separate_test_login = no

[PIPELINE]
# Directory for Slurm accounting logs.
acct_path = %(data_dir)s/accounting

# Per-host raw stats tree; subdir names must end with host_name_ext.
archive_dir = %(data_dir)s/archive

# Daily sealed monitor archive directory.
daily_archive_dir = %(data_dir)s/daily_archive

# Absolute update_metrics + plot/detail prewarm thread pool size (default 32).
# metrics_pool_processes = 32

# Metrics scheduler: strict_date, global_fifo, or global_priority (default global_priority).
# metrics_scheduler_mode = global_priority

# Prefetch chunk descriptors for global scheduler (default 8).
# metrics_scheduler_prefetch_chunks = 8

# Ready-jid queue depth target before compute (default 100; sole ready-queue depth).
# metrics_scheduler_ready_queue_target = 100

# Fill idle metrics-pool slots with smaller ready-queue jobs (default yes).
# metrics_idle_slot_supplement_enabled = yes

# Prefer supplements with estimated_sample_count below this soft max (default 10000).
# metrics_supplement_sample_soft_max = 10000

# Never supplement at or above this hard sample max (default 80000).
# metrics_supplement_sample_hard_max = 80000

# Plot prewarm: inline or pipeline_required (default pipeline_required). Prewarm runs on metrics_pool_processes after successful metrics (no secondary pool).
# metrics_plot_prewarm_mode = pipeline_required

# Plot aggregate SQL time-slice seconds (default 3600); design 5000x48x60.
# metrics_plot_aggregate_time_slice_s = 3600

# Max host×time rows per plot aggregate DF (default 1000000); not 14.4M.
# metrics_plot_aggregate_max_host_time_points = 1000000

# imap_unordered poll timeout in Metrics.run seconds (default 5).
# metrics_run_poll_timeout_s = 5

# Max no-progress seconds in Metrics.run before abort (default 900).
# metrics_run_stall_timeout_s = 900

# statement_timeout ms for metrics thread compute; 0 disables it (default 120000).
# metrics_worker_statement_timeout_ms = 120000

# gc.set_threshold for update_metrics; higher = fewer stop-the-world GC pauses, 0 = interpreter default (default 0).
# metrics_gc_threshold = 0

# statement_timeout ms for metrics persistence (default 120000).
# metrics_persist_statement_timeout_ms = 120000

# lock_timeout ms for metrics persistence (default 10000).
# metrics_persist_lock_timeout_ms = 10000

# Max jids per proxy host_data readiness batch on PostgreSQL (default 48).
# metrics_proxy_reject_jid_batch_size = 48

# Max sum of job window seconds per compute batch; 0 disables (default 0).
# metrics_compute_batch_max_window_s = 0

# Max seconds for one job in a batch; 0 disables (default 0).
# metrics_compute_batch_max_single_job_s = 0

# Assumed window seconds when job times unknown (default 172800).
# metrics_compute_batch_unknown_runtime_s = 172800

# Watchdog on metrics phase wall time per batch seconds (default 120).
# metrics_compute_watchdog_s = 120

# Watchdog on full batch wall; 0 uses metrics-only watchdog (default 0).
# metrics_compute_total_watchdog_s = 0

# First retry delay for a deferred not-ready jid in seconds; doubles per attempt up to the quarantine time (default 10).
# metrics_deferred_not_ready_retry_s = 10

# Max retries for deferred not-ready jids (default 30).
# metrics_deferred_not_ready_max_retries = 30

# Max age before giving up on deferred jid seconds (default 900).
# metrics_deferred_not_ready_max_age_s = 900

# Quarantine time for repeatedly deferred jid seconds (default 300).
# metrics_deferred_not_ready_quarantine_s = 300

# Defer update_metrics until in-window host_data samples exist within margins of Slurm start and end (job aggregate, any accounting host). Default yes.
# metrics_readiness_require_window_coverage = yes

# Start edge tolerance seconds (default 600): MIN(time) in window must be <= start + margin.
# metrics_readiness_start_margin_seconds = 600

# End edge tolerance seconds (default 600): MAX(time) in window must be >= end - margin.
# metrics_readiness_end_margin_seconds = 600

# Seconds after job end to wait for every host to cover the window before computing with the hosts that reported (default 21600).
# metrics_readiness_host_wait_seconds = 21600

# Seconds the long-running update_metrics loop idles between scheduler passes (default 60).
# metrics_scheduler_pass_interval_s = 60

# Seconds between background /pub/ expansion-factor artifact refreshes, minimum 60 (default 3600).
# metrics_public_ef_interval_s = 3600

# Ingest parse pool size and Codon worker process count (default 64; capped at 128 Codon workers).
# sync_ingest_pool_processes = 64

# Codon stripe slots as fraction of parse pool (default 1.0; legacy 0.5 was retired).
# sync_codon_context_pool_fraction = 1.0

# Codon worker RSS in MiB above which the worker is replaced between files (default 1536). Boehm's heap only grows; this bounds total worker memory.
# sync_codon_worker_recycle_rss_mib = 1536

# Ingest write-pool width / max concurrent ingest DB sessions (default 0 = max(1, parse//2)).
# sync_ingest_write_pool_processes = 0

# Max parse→write queue slots (payload count, not bytes; default 0 = 2x sync_ingest_pool_processes).
# sync_ingest_parse_queue_max = 0

# Soft max MiB per streaming parse→write flush chunk (default 512; sample-boundary overage OK).
# sync_ingest_parse_flush_max_mib = 512

# Codon file-session flush window cap in MiB (default 1); effective window is min(this, sync_ingest_parse_flush_max_mib). Large windows slow Codon's GC.
# sync_codon_parse_flush_max_mib = 1

# Concurrent daily-tar append slots / archive spawn pool size (default 4).
# sync_archive_pool_processes = 4

# Max concurrent sealed-day streams for sync_timedb_archive backfill (default 1).
# sync_timedb_archive_max_concurrent_sealed_days = 1

# Catchup ingest files discover admits before it skips the rest until the next full walk (default 50000; ~1.2 KB of job-store snapshot per queued file).
# sync_ingest_queue_max_size = 50000

# Incremental pending rescan: GNU find -mtime -N days (default 1 = last 24h).
# sync_ingest_rescan_mtime_days = 1

# Hours between whole-archive discover walks from the idle pass (default 6; 0 disables; a walk that dropped files at the queue cap is repeated once the queue drains).
# sync_ingest_full_rescan_interval_hours = 6

# Max in-memory archive work queue size (default 1000).
# sync_archive_queue_max_size = 1000

# Capacity bound per durable Redis job:v1 queue key (default 2000000).
# sync_job_queue_max_members = 2000000

# Archive task retries before dead-letter behavior (default 5).
# sync_archive_retry_max_attempts = 5

# Base archive retry backoff seconds (default 1).
# sync_archive_retry_backoff_base_seconds = 1

# Max archive retry backoff seconds (default 60).
# sync_archive_retry_backoff_max_seconds = 60

# Dead-end remediation (sync_timedb state machine). Dead letters re-admit after each cooldown (comma list, seconds); after the last one the raw file is quarantined (restorable) so its day can close.
# sync_dead_letter_readmit_backoff_s = 3600,21600,86400

# Longer schedule for environment errors (DB outage, EAGAIN, ENOSPC, EPERM), which never burn a file's attempts.
# sync_dead_letter_env_backoff_s = 21600,86400,259200

# Requeues without progress before a job escalates into the cooldown (G1).
# sync_noprogress_escalate_after = 50

# Age (s) after which a sticky negative flag (day_skip, degraded) is re-checked and cleared when its gate passes (G3); 0 disables.
# sync_negative_flag_revalidate_s = 86400

# Free-space reserve on top of a truncated-tar salvage backup (bytes).
# sync_tar_salvage_min_free_bytes = 1073741824

# Back up the whole tar instead of only the tail past the cut (needs S free).
# sync_tar_salvage_full_copy = no

# Free-space reserve for reseal/restore/rebuild/repair/salvage (bytes); a denial defers as env:ENOSPC, never a failure.
# sync_archive_min_free_bytes = 10737418240

# Free bytes on the daily archive filesystem below which appends yield to day close; K/M/G/T suffixes, 0 disables (default 1T).
# sync_archive_space_pressure_free_bytes = 1T

# Hours a stranded archive scratch file (<day>.tar.<kind>.tmp), hps_* staging dir or sidecar write temp (.atomic.*, *.json.tmp) may sit unmodified before the idle sweep removes it (default 24; 0 disables; report mode only logs).
# sync_archive_scratch_max_idle_hours = 24

# report: log what the boot migrations (re-admit, reopen, restore) would do and change nothing; apply: run them.
# sync_dead_end_remediation_mode = apply

# Max re-admissions / reopens per reconstruct pass.
# sync_dead_end_migration_batch = 500

# Processed-file checkpoint writes per batch (default 100).
# sync_checkpoint_flush_batch_size = 100

# Max raw paths per tar -T append batch in sync_timedb (default 256).
# sync_timedb_tar_append_batch_size = 256

# Max DB timestamps cached per duplicate-detection window (default 100000).
# sync_host_itimes_cache_max_timestamps_per_entry = 100000

# Poll interval for sync_timedb pool waits seconds (default 5).
# sync_pool_poll_timeout_s = 5

# Minimum seconds between repeated pool imap stall defer WARN lines (default 60; 0 = every poll).
# sync_pool_stall_defer_log_interval_s = 60

# Polls to tolerate maxtasksperchild worker recycle (deprecated; use grace_seconds).
# sync_pool_worker_recycle_grace_polls = 2

# Wall-clock seconds before WARN on slow maxtasksperchild replacement per dead PID (default 60).
# sync_pool_worker_recycle_grace_seconds = 60

# Idle-pool ghost reconcile: redispatch stale pending_async before exit 124 (default 3 rounds).
# sync_pool_idle_reconcile_max_rounds = 3

# Idle polls between reconcile redispatch rounds when workers are idle (default 4).
# sync_pool_idle_reconcile_polls_per_round = 4

# Seconds without parse/write progress before soft-requeue (default 1800).
# sync_ingest_stall_idle_s = 1800

# Redis job lease EX / external ceiling reference (not an ingest soft-kill wall).
# sync_ingest_per_file_timeout_max_s = 86400

# Cache daily tar member maps per worker on DB-complete ingest checks (default yes).
# sync_archive_members_cache_enabled = yes

# Max cached daily archive member maps per ingest/archive worker (default 64).
# sync_archive_members_cache_max_entries = 64

# Populate wait wall seconds; 0 = idle+heartbeat only (default 0); fnctl lock uses fnctl INI when 0.
# sync_archive_members_populate_max_seconds = 0

# Exclusive sealed→tar restore lease TTL; renewed while zstd -o runs (default 14400).
# sync_daily_tar_restore_lease_seconds = 14400

# Shared fnctl read-lock wait for non-populate archive verify paths (default 180).
# sync_archive_members_fnctl_read_lock_timeout_seconds = 180

# Waiter poll interval seconds for incremental member lookups (default 0.25).
# sync_archive_members_wait_poll_seconds = 0.25

# Dedicated threads that stream sealed/tar archives into the in-process member store (default 4).
# sync_archive_members_populate_pool_processes = 4

# Supervisor RSS limit MiB; 0 disables fail-fast exit (default 0).
# sync_supervisor_rss_limit_mb = 0

# Process-tree defer roof as percent of pipeline cgroup memory.max (default 40; 0 off).
# sync_process_tree_rss_limit_cgroup_pct = 40

# Hard exit when process-tree RSS exceeds this percent of memory.max; 0 off.
# sync_process_tree_rss_exit_cgroup_pct = 0

# Max stats file size for readlines fast path; larger files stream-parse (default 512 MiB).
# sync_ingest_max_file_read_bytes = 536870912

# Route duplicate scan through streaming path above this size (default 8 MiB).
# sync_ingest_stream_duplicate_scan_bytes = 8388608

# Tail timestamp lines probed before full duplicate scan on large head-present files (default 500).
# sync_ingest_db_complete_tail_window_lines = 500

# Recycle ingest pool workers after N files; 0 unlimited (default 0; archive pools always maxtasksperchild=1).
# sync_ingest_pool_maxtasksperchild = 0

# Per-task gc.collect() + malloc_trim after each ingest task (default no); set yes on sites with a small RSS roof (Horizon), see docs/DEPLOY_CONCURRENCY_AND_NUMA.md for Horizon RSS tuning.
# sync_ingest_malloc_trim_after_file = no

# Worker memory telemetry: one batch_summary line per ingest chunk (default no; enable for soak).
# sync_ingest_worker_memory_telemetry = no

# Emit worker memory telemetry every N ingest chunks (default 1).
# sync_ingest_worker_memory_telemetry_every_n_chunks = 1

# Exhaustive OOM attribution lines (cgroup/stat/RSS/inflight/headroom/file_cache). Default no.
# sync_timedb_mem_telemetry = no

# Require this many MiB free under memory.max before multi-file ingest admit / append fill (default 4096; 0=off). Does not block alone-oversized ingest when inflight is empty. Soft roof unchanged.
# sync_cgroup_admit_headroom_mib = 4096

# Max cgroup memory.stat file as percent of memory.max before multi-file admit (default 60). Effective MiB at runtime; 60 on 128g ≈78643 MiB. Set 0 on small compose to disable gate.
# sync_cgroup_admit_max_file_cache_cgroup_pct = 60

# Recycle ingest pool when oldest inflight submit age reaches this many seconds (default 3600; 0=off). Requeues collateral without attempt burn via the MainThread pause protocol (stuck_cohort_recycle telem).
# sync_ingest_stuck_inflight_recycle_s = 3600

# Parse-stage and write/COPY shares on ingest outcome lines (default no; enable via INI on redeploy, not pipeline env).
# sync_ingest_telemetry = no

# Cooperative recycle when maxtasksperchild=0 (supervisor retires worker after result).
# sync_ingest_recycle_worker_on_failure = yes

# Cooperative recycle RSS fraction of per-worker roof (default 0.5).
# sync_ingest_cooperative_recycle_rss_fraction = 0.5

# Delay ms before re-checking worker RSS for cooperative recycle (default 50).
# sync_ingest_rss_recheck_delay_ms = 50

# Ingest-first durability semantics: checkpoint after DB even if append fails (default yes).
# sync_enable_ingest_first_durability_mode = yes

# Require head+tail DB ingest readiness before tar append or raw delete (default yes). When yes, first and last digit-leading timestamp seconds must exist in host_data. When listend live DB ingest is on, archive/delete also requires a sync_timedb file-complete mark.
# sync_archive_require_db_ingest = yes

# listend async dual-write of samples to Timescale after archive append (default no; opt-in = yes).
# listend_db_ingest_enabled = no

# Host-affine thread count for listend live DB ingest (default 32). Size against Postgres max_connections alongside sync_ingest_pool_processes.
# listend_db_ingest_pool_processes = 32

# Total in-flight listend DB-queue memory budget in GiB across all workers (default 8; values above 8 are clipped to 8).
# listend_db_ingest_queue_max_gb = 8

# Samples cached per listend DB worker before one bulk_create (default 100).
# listend_db_ingest_batch_samples = 100

# Max pending host+proc ORM rows per listend DB worker before flush (default 2000).
# listend_db_ingest_flush_max_rows = 2000

# Seconds to hold a non-empty pending batch when the queue is never empty (default 5).
# listend_db_ingest_flush_hold_s = 5

# Max proc names per peak-merge DB lookup (default 256); avoids giant OR queries.
# listend_db_ingest_proc_peak_lookup_chunk = 256

# PostgreSQL statement_timeout ms for listend DB workers (default 600000 = 10 min).
# 0 leaves portal db_statement_timeout_ms unchanged.
# listend_db_ingest_statement_timeout_ms = 600000

# When live DB queues are full: drop (archive+ack, shed DB) or pause (nack, stop consume).
# listend_db_ingest_backpressure = drop

# Per-consumer RabbitMQ basic_qos prefetch in drop mode (default 32; 16 consumers → 512 process-wide; leftover 512 is 512 each — set 32). Pause still uses 1.
# listend_amqp_prefetch = 32

# Competing AMQP consume threads, one BlockingConnection each (default 16; floor 1; no upper clamp). Archive writers are 2× this count.
# listend_amqp_consumer_count = 16

# Keep uncompressed YYYY-MM-DD.tar after sealing globally (default no). Prior days drop at seal when raw is gone; calendar-today uses grace hours below.
# archive_keep_uncompressed_tar = no

# Hours after local midnight to retain today's uncompressed .tar when global keep is off (default 24).
# archive_today_uncompressed_tar_grace_hours = 24

# zstd -T thread count for niced seal/restore/decompress; 0 uses -T0 (all cores per job, default).
# archive_zstd_threads = 0

# zstd -T for un-niced ingest/populate sealed streams (default 4).
# ingest_zstd_threads = 4

# Added nice for archive zstd subprocesses; 0 disables (default 10).
# archive_zstd_nice = 10

# ionice class for archive zstd: 0=none, 2=best-effort, 3=idle (default 2).
# archive_zstd_ionice_class = 2

# ionice level within class for archive zstd, 0-7 (default 6).
# archive_zstd_ionice_level = 6

# Max concurrent daily tar seals during maintenance (default 4).
# archive_seal_parallel_workers = 4

# Max parallel threads for sealed/tar validation read-lock scope (default 2).
# sync_archive_validation_max_workers = 2

# zstd compression level 1-19 for .tar.zst (default 7; benchmark before raising above 9).
# archive_zstd_level = 7

# Linux-only: posix_fadvise SEQUENTIAL/DONTNEED on pipeline file I/O (ingest, archive, zstd). Default yes when omitted; set no only for A/B tuning or debugging.
# sync_pipeline_drop_page_cache = yes

# Legacy name for sync_pipeline_drop_page_cache (used when the new key is omitted).
# archive_zstd_drop_page_cache = yes

# Max raw paths processed per day_close batch (default 1000; renamed from archive_janitor_raw_paths_per_tick).
# sync_day_close_raw_paths_per_batch = 1000

# Hours after calendar day end before day_close seal/delete (default 32).
# sync_day_close_min_age_hours = 32

# Inclusive hot-band window for ingest job scores (days; default 3, minimum 1).
# sync_ingest_hot_days = 3

# DAY_CLOSE pipeline occupancy and parallel worker count (default 8).
# sync_day_close_max_inflight = 8

# Recover stale day-close manifest entries on coordinator init (default 7200s; 0 = off).
# sync_day_close_manifest_stale_seconds = 7200

# Max deletes per day-close delete loop iteration; 0 = unlimited per iteration (default 0).
# sync_day_close_raw_removal_max_deletes_per_pass = 0

# Seconds before logging an archive pool job as stalled (default 600).
# sync_archive_worker_stall_seconds = 600

[CACHE]
# Redis URL for Django/listend cache (compose default is the shared Unix socket).
redis_location = unix:///run/redis/redis.sock?db=1

[XALT]
# XALT database engine when XALT integration is enabled.
xalt_engine =

# XALT database name.
xalt_name =

# XALT database user.
xalt_user =

# XALT database password.
xalt_password =

# XALT database host.
xalt_host =
