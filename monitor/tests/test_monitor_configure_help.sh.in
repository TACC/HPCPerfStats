#!/bin/sh
# Regression: --enable-all-static must remain in configure --help (static bundle).
# Invoked by check-local via $(SHELL) $(srcdir)/this-file (not AC_CONFIG_FILES).
set -e
cd "$(dirname "$0")/.." || exit 1
test -f ./configure
./configure --help | grep -q 'enable-all-static'
./configure --help | grep -q 'enable-legacy-pmcs'
./configure --help | grep -q 'enable-metric-profiler'
./configure --help | grep -q 'with-metric-profiler-backend'
