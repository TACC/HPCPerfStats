# Compose overlay for local/CI test workflows (tests/run_*_workflow.sh).
#
# Operators / agents: cp this file to tests/docker-compose.test-overlay.yaml
# (gitignored). compose_test_cmd.sh copies automatically when missing.
#
# Production bind devices live in docker-compose.settings.yaml (from
# docker-compose.settings.yaml.example; included by docker-compose.yaml).
# This overlay remaps every bind-backed named volume to a Compose-managed named
# volume so rootless Podman tests and CI do not need production bind paths.
# Production deploys use base compose only (settings included; no app overlay).
# TLS: test_proxy_ssl_source bind-mounts tests/fixtures/proxy-ssl at /mnt/ssl-source;
# proxy entrypoint materializes real PEM files before nginx starts.

services:
  web:
    volumes:
      - test_hpcperfstatsdata:/hpcperfstats/
      - test_staticfiles_data:/home/hpcperfstats/staticfiles
      - test_media_data:/home/hpcperfstats/hpcperfstats/site/hpcperfstats_site/media
      - test_staticfiles_ram:/home/hpcperfstats/staticfiles-ram
      - test_media_ram:/home/hpcperfstats/media-ram
      - redis_runtime:/run/redis
  pipeline:
    volumes:
      - test_hpcperfstatsdata:/hpcperfstats/
      - test_ssh_keys:/hpcperfstats/.ssh/:ro
      - redis_runtime:/run/redis
  proxy:
    volumes:
      - test_staticfiles_ram:/srv/static:ro
      - test_media_ram:/srv/media:ro
      - test_proxy_ssl_source:/mnt/ssl-source:ro
  db:
    volumes:
      - test_postgres_data:/var/lib/postgresql/data/
  db_pg18:
    volumes:
      - test_postgres_data_pg18:/var/lib/postgresql
  rabbitmq:
    volumes:
      - test_rabbitmq_messages:/var/lib/rabbitmq/

volumes:
  test_hpcperfstatsdata:
  test_staticfiles_data:
  test_media_data:
  test_staticfiles_ram:
  test_media_ram:
  test_postgres_data:
  test_postgres_data_pg18:
  test_rabbitmq_messages:
  test_ssh_keys:
  test_proxy_ssl_source:
    driver: local
    driver_opts:
      type: none
      device: ./tests/fixtures/proxy-ssl
      o: bind
