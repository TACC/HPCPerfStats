# These are the two containers that contain the web and data processing code
# CPU pinning fragments: see docker-compose.yaml (includes cpu-pinning.infra + app).
#
# Operators: cp this file to docker-compose.app.yaml (gitignored locally).
# Any non-dev compose change must update this .example in the same task — see
# hpcperfstats/cursor-rules/docker-compose-app-example-sync.mdc.

services:
  web:
    build:
      context: ./
      dockerfile: Dockerfile
      target: hpcperfstats-full
    image: hpcperfstats
    restart: always
    command: /home/hpcperfstats/services-conf/django_startup.sh
    environment:
      - HPCPERFSTATS_INI=/home/hpcperfstats/hpcperfstats.ini
      - STATIC_ROOT=/home/hpcperfstats/staticfiles
    volumes:
      - staticfiles_data:/home/hpcperfstats/staticfiles
      - media_data:/home/hpcperfstats/hpcperfstats/site/hpcperfstats_site/media
      - hpcperfstatsdata:/hpcperfstats/
    networks:
      hpcperfstats_net:
        aliases:
          - web

  pipeline:
    image: hpcperfstats
    restart: always
    # cgroup memory.max for sync_timedb / supervisord (Podman/Docker --memory).
    # Tune from host MemTotal minus db, web, redis; 128g fits ~192 GiB hosts with no swap.
    mem_limit: 128g
    memswap_limit: 128g
    stop_grace_period: ${HPCPERFSTATS_PIPELINE_STOP_GRACE:-2m}
    depends_on:
      - web
    command: /home/hpcperfstats/services-conf/supervisor_startup.sh
    environment:
      - HPCPERFSTATS_INI=/home/hpcperfstats/hpcperfstats.ini
    ports:
      - 514:514/udp
      - 514:514/tcp
    volumes:
      - hpcperfstatsdata:/hpcperfstats/
      # Override HPCPERFSTATS_PIPELINE_SSH_DIR to a host path containing keys.
      - ${HPCPERFSTATS_PIPELINE_SSH_DIR:-/tmp/hpcperfstats-pipeline-ssh}:/hpcperfstats/.ssh/:ro
    networks:
      hpcperfstats_net:
        aliases:
          - pipeline

volumes:
  staticfiles_data:
  media_data:
  hpcperfstatsdata:
    driver: local
    driver_opts:
      type: none
      device: /opt/hpcperfstats_data/
      o: bind

networks:
  hpcperfstats_net:
    name: hpcperfstats_net
