# Site-local Compose settings (bind volumes + optional knobs).
#
# Operators: cp this file to docker-compose.settings.yaml (gitignored).
# Any operator-facing change must update this .example in the same task —
# see hpcperfstats/cursor-rules/docker-compose-settings-example-sync.mdc.
#
# Base stack: docker-compose.yaml (includes this file).
# TLS PEMs: proxy_ssl_source volume (flat PEM dir default); entrypoint copies
# real files into /etc/ssl/hpcperfstats before nginx starts.

volumes:
  hpcperfstatsdata:
    driver: local
    driver_opts:
      type: none
      device: /data/hpcperfstats_data/site_data
      o: bind
  staticfiles_data:
    driver: local
    driver_opts:
      type: none
      device: /data/hpcperfstats_site/staticfiles
      o: bind
  media_data:
    driver: local
    driver_opts:
      type: none
      device: /data/hpcperfstats_site/media
      o: bind
  postgres_data:
    driver: local
    driver_opts:
      type: none
      device: /data/hpcperfstats_db/pg15
      o: bind
  # Homegrown PG18 dual-run volume (profile pg18-migrate). Create + chown before
  # starting db_pg18 (Alpine postgres is uid/gid 70):
  #   mkdir -p /data/hpcperfstats_db/pg18 && chown -R 70:70 /data/hpcperfstats_db/pg18
  # Bind replaces image ownership; empty root:root → Permission denied on mkdir 18/.
  # See docs/OPERATOR_PG18_MIGRATION.md. After cutover, operators may re-point
  # the primary bind and retire pg15.
  postgres_data_pg18:
    driver: local
    driver_opts:
      type: none
      device: /data/hpcperfstats_db/pg18
      o: bind
  rabbitmq_messages:
    driver: local
    driver_opts:
      type: none
      device: /data/hpcperfstats_data/rabbitmq
      o: bind
  ssh_keys:
    driver: local
    driver_opts:
      type: none
      # Host directory with pipeline SSH keys (edit for your site).
      device: /keys_directory/.ssh
      o: bind
  proxy_ssl_source:
    driver: local
    driver_opts:
      type: none
      # Host directory with fullchain.pem + privkey.pem at this path (edit for your site).
      # See below for extra configuration for symlinks outside of this directory (Lets Encrypt)
      device: /opt/certs
      o: bind

# Optional knobs — copy a block under `services:` in your local
# docker-compose.settings.yaml and uncomment as needed for this site.
#
# services:
#   web:
#     # Publish Django/gunicorn directly on the host (normally only via proxy 80/443).
#     ports:
#       - "${HPCPERFSTATS_WEB_PORT:-8000}:8000"
#   db:
#     # Allow the database to be open to the world.
#     ports:
#       - "5432:5432"
#   rabbitmq:
#     # Allow the rabbitmq management interface to be open to the world.
#     ports:
#       - "15672:15672"
#   proxy:
#     # Let's Encrypt only — PEMs under live/hostname with archive symlinks.
#     # Set proxy_ssl_source.device to /etc/letsencrypt (parent tree), then uncomment:
#     environment:
#       - HPCPERFSTATS_SSL_CERTS_REL=live/hpcperfstats02.example.com
#   pipeline:
#     # Debugging only — normal usage should never need this.
#     cap_add:
#       - SYS_PTRACE
#     # Per-site cgroup overrides (defaults are 128g in docker-compose.yaml):
#     # mem_limit: 128g
#     # memswap_limit: 128g
#     # stop_grace_period: ${HPCPERFSTATS_PIPELINE_STOP_GRACE:-2m}
