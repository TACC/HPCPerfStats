# The RMQ and Portal sections have been configured to work for the docker installation. You will only need to edit the Default section and the host_name_ext variable under the Portal section, and we recommend editing just these and performing the installation using our instructions. If you need to edit some variables, please note that a lot of them are tied to the docker yml file.

[DEFAULT]
# Short name of your cluster i.e. frontera
machine		          = cluster_name

# FQDN suffix for cluster nodes (short-host.FQDN). sync_timedb and archive layout
# use this: under archive_dir, only immediate subdirs whose names *end with* this
# string (e.g. c123.frontera.tacc.utexas.edu when host_name_ext is frontera.tacc.utexas.edu) are scanned for stats files.
host_name_ext      = %(machine)s.domain.edu

# Path you would like all of HPCPerfStats' data to be stored. It will be the central location where all the file operations occur.
data_dir 	          = /hpcperfstats/

# FQDN for the web server host, split with commas if multiple. The docker proxy image
# reads this list at build time into /etc/nginx/hps-proxy-allowed-hosts.inc (included by
# nginx.conf): nginx only terminates TLS / serves static files / proxies Django for these
# Host names; other hosts get HTTP 404 (HTTPS mismatched SNI is rejected).
server 		          = servername.domain.edu, stats.cluster.domain.edu

# Scheme used when building browser CORS Origin URLs from ``server`` (production /
# debug=no only). Defaults to https (nginx TLS termination). Use http only for
# TLS-off deployments.
# cors_origin_scheme = https

# Keywords from queues which should be ignored
restricted_queue_keywords = ['secure', 'secret']

# Debug Output in the docker logs
debug                 = True

# This is used to determine if a user (presumably a staff member) can see all jobs
staff_email_domain   = lab.hpcisgreat.edu

# The cluster and docker host need to share this timezone.
# The timezone must come from this list:
# http://en.wikipedia.org/wiki/List_of_tz_zones_by_name
timezone = America/Chicago

# Total amount of cores that are available for this application (omit to default to 40).
total_cores = 40

# Concurrency caps (optional; see docs/DEPLOY_CONCURRENCY_AND_NUMA.md).
# Defaults: parallel_db_prefetch_max=4 (API ThreadPoolExecutor + ORM prefetch);
# summary plot inner aggregate prefetch is hard-capped at 2 threads (summaryplot).
# max_gunicorn_workers = 8
# metrics_pool_process_cap = 4
# (Compose diagnosis baseline: docs/update_metrics_speedup_followup.md — compute phase dominated at default UM_DIAG seed scale.)
# parallel_db_prefetch_max = 2
# api_small_executor_max_workers = 2
# sync_pool_process_cap = 2
# archive_pool_process_cap = 1
# metrics_scheduler_prefetch_chunks = 4
# metrics_scheduler_ready_queue_target = 500
# metrics_prewarm_workers = 2
# metrics_scheduler_compute_threads = 2
# Cost-aware compute batching (0 disables): cap sum of job window seconds and/or one job's window per batch
# metrics_compute_batch_max_window_s = 0
# metrics_compute_batch_max_single_job_s = 0
# metrics_compute_batch_unknown_runtime_s = 172800
# Prewarm drain budget after each Metrics.run batch (base + per-successful-job, optional ceiling)
# metrics_prewarm_drain_batch_budget_s = 2.0
# metrics_prewarm_drain_per_job_s = 0.5
# metrics_prewarm_drain_batch_budget_max_s = 60
# Watchdog downshift for adaptive batch cap (total 0 = metrics-only)
# metrics_compute_watchdog_s = 120
# metrics_compute_total_watchdog_s = 0
# Deferred not-ready backoff (strict readiness)
# metrics_deferred_not_ready_retry_s = 10
# metrics_deferred_not_ready_max_retries = 30
# metrics_deferred_not_ready_max_age_s = 900
# metrics_deferred_not_ready_quarantine_s = 300
# sync_ingest_queue_max_size = 500
# sync_archive_queue_max_size = 250
# sync_checkpoint_flush_batch_size = 50
# sync_enable_cpuset_priority_budget = yes
# pipeline_overlap_mode = balanced
# metrics_ingest_priority_scale = 0.75
# metrics_min_processes = 1
# sync_budget_ingest_ratio = 0.60
# sync_budget_archive_ratio = 0.15
# sync_budget_metrics_ratio = 0.20
# sync_budget_reserve_ratio = 0.05
# sync_budget_min_metrics_percent = 10
# sync_budget_min_archive_percent = 10
# sync_enable_overprovision_mode = no
# sync_budget_overcommit_factor = 1.00
# sync_overprovision_ingest_multiplier = 1.00
# sync_overprovision_archive_multiplier = 1.00
# sync_overprovision_metrics_multiplier = 1.00
# sync_db_writer_pool_multiplier = 0.50
# sync_db_writer_pool_cap =
# sync_adaptive_dispatch_enabled = yes
# sync_dispatch_burst_factor = 2.0
# sync_dispatch_archive_backoff_ratio = 0.50
# sync_dispatch_step_size = 8
# Django DB: persistent connection lifetime (seconds) and PostgreSQL session timeouts (ms)
# db_conn_max_age = 90
# db_statement_timeout_ms = 120000
# db_idle_in_transaction_session_timeout_ms = 300000
# cpuset_pin_min_total_cores = 32
# cpuset_pin_min_cores_per_node = 16
# numa_pin_max_nodes_auto = 16
# pin_proxy_in_compose = no
# update_metrics readiness: max jids per proxy host_data aggregate (default 48, min 8)
# metrics_proxy_reject_jid_batch_size = 48
# Skip job detail / plot prewarm after metrics (catch-up / diagnosis only; job pages colder until prewarm elsewhere)
# metrics_scheduler_skip_prewarm = no
# web_numa_node =
# pipeline_numa_node =

# Django SECRET_KEY (do not commit real keys; set in ini or env for production)
secret_key = change-me-to-a-long-random-string

[OAUTH2]
# oauth client id
client_id =

# oauth secret key
client_key =

# Base OAUTH URL
oauth_base_url = https://tacc.tapis.io/v3

# URL for authorization
authorize_url     = %(oauth_base_url)s/oauth2/authorize?client_id=%(client_id)s&redirect_uri=%%s&response_type=code&state=%%s


[RMQ]
# Rabbit MQ server (pre-configured for container installation)
rmq_server 	       = rabbitmq

# Rabbit MQ queue (pre-configured for container installation)
rmq_queue 	       = %(machine)s


[SYSLOG]
# Comma- or line-separated IPv4 CIDRs allowed to send syslog to the pipeline on
# port 514 (TCP/UDP). When blank or [SYSLOG] omitted, all IPv4 sources are allowed
# (backward compatible). IPv6-only entries are ignored until syslog-ng filter
# support is extended.
# allow_from = 10.0.0.0/8, 192.168.50.0/24
#
# listen_tcp = yes
# listen_udp = yes


[PORTAL]
# Path where all of the slurm logs for job accounting data will be stored (pre-configured for container installation)
acct_path          = %(data_dir)s/accounting

# Raw node stats: one subdirectory per host; dirname must end with DEFAULT.host_name_ext
archive_dir	       = %(data_dir)s/archive



# Name of the postgres database (pre-configured for container installation)
dbname             = hpcperfstats

# Path where all of the aggregate, raw Rabbit MQ data is stored, which can be used to potentially recreate the database. (pre-configured for container installation)
daily_archive_dir  = %(data_dir)s/daily_archive

# Deferred compression: sync_timedb appends to YYYY-MM-DD.tar; pigz seal + removal
# of verified raw stats run on archive_pigz_interval_seconds (default 8 hours).
# Keep yes unless you accept re-decompressing on every append for that day.
# archive_keep_uncompressed_tar = yes
# archive_seal_idle_seconds = 60
# archive_pigz_threads = 8
# archive_pigz_level = 8
# archive_pigz_interval_seconds = 28800
# Require first stats timestamp in DB before daily tar append or raw file removal (default yes).
# sync_archive_require_db_head_ingest = yes

# Django engine backend (pre-configured for container installation)
engine_name        = django.db.backends.postgresql 

# Postgres username (pre-configured for container installation)
username           = hpcperfstats

# Postgres password (pre-configured for container installation)
password           = hpcperfstats

# Database host (pre-configured for container installation)
host               = db

# Database port (pre-configured for container installation)
port               = 5432


[CACHE]
# Redis URL for ORM/view caching (e.g. redis://host:port/db)
redis_location = redis://redis:6379/1

[XALT]
# Name of XALT engine
xalt_engine        = 

# XALT name
xalt_name          =

# XALT username
xalt_user          =

# XALT password
xalt_password      =

# XALT host
xalt_host          =
