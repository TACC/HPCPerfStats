{
  "name": "hpcperfstats-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "write-site-identity": "node scripts/write-site-identity.mjs",
    "predev": "npm run write-site-identity",
    "dev": "next dev",
    "generate:api": "orval --project hpcperfstatsZod && orval --project hpcperfstats",
    "prebuild": "npm run write-site-identity",
    "prebuild:prod": "npm run write-site-identity",
    "pretypecheck": "npm run write-site-identity",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "lint": "eslint .",
    "lint:dead": "knip",
    "build:prod": "npm run generate:api && next build && HPCPERFSTATS_PRODUCTION_STATIC=1 node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "build": "npm run generate:api && next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "start": "next start",
    "pretest": "npm run write-site-identity",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bokeh/bokehjs": "3.10.2",
    "@eslint/js": "^10.0.1",
    "@orval/zod": "8.49.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^31.0.1",
    "knip": "^6.48.0",
    "orval": "8.49.0",
    "shadcn": "^4.23.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "dompurify": "^3.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
