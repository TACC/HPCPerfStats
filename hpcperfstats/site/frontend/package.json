{
  "name": "hpcperfstats-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "write-site-identity": "node scripts/write-site-identity.mjs",
    "predev": "npm run write-site-identity",
    "dev": "next dev",
    "generate:api": "orval --project hpcperfstatsZod && orval --project hpcperfstats",
    "prebuild": "npm run write-site-identity",
    "prebuild:prod": "npm run write-site-identity",
    "pretypecheck": "npm run write-site-identity",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "lint": "eslint .",
    "lint:dead": "knip",
    "build:prod": "npm run generate:api && next build && HPCPERFSTATS_PRODUCTION_STATIC=1 node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "build": "npm run generate:api && next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "start": "next start",
    "pretest": "npm run write-site-identity",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@bokeh/bokehjs": "3.10.0",
    "@eslint/js": "^10.0.1",
    "@orval/zod": "8.40.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "orval": "8.40.0",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@babel/core": "^8.0.1",
    "@hono/node-server": "^2.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "brace-expansion": "^5.0.9",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "fast-uri": "^4.1.3",
    "qs": "^6.16.0",
    "hono": "^4.13.5",
    "ip-address": "^10.7.0",
    "js-yaml": "4.3.2",
    "lodash": "^4.18.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "undici": "^8.10.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
