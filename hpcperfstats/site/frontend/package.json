{
  "name": "hpcperfstats-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "generate:api": "orval --project hpcperfstatsZod && orval --project hpcperfstats",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:api && next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "build:with-bokeh-playwright-smoke": "next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "start": "next start",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@bokeh/bokehjs": "3.9.1",
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-slot": "^1.2.5",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.80.7",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "next": "^15.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.57.0",
    "react-paginate": "^8.3.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@orval/zod": "^7.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "orval": "^7.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "lodash": "^4.17.24",
    "postcss": "^8.5.15"
  }
}
