# .git is intentionally IN the build context so frontend-builder can COPY it and
# resolve SITE_GIT_COMMIT via git rev-parse. hpcperfstats-base strips .git after
# COPY . . so the runtime image does not retain history.
.gitignore
.cursor
.venv
venv
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
dist/
build/
*.egg-info/
node_modules/
npm-debug.log*
yarn-error.log*
tmp/
temp/
*.log

# Entire monitor C daemon tree (sources, build artifacts, unit tests)
monitor/

# External API client (host/CLI only; not runtime in web/pipeline image)
hpcperfstats-tools/

# ---------------------------------------------------------------------------
# Tests and test-only artifacts (keep Docker build context lean; not runtime).
# ---------------------------------------------------------------------------

# Pytest trees (hpcperfstats/tests, site/lib/machine/tests, tests/pipeline_e2e, …)
tests/
**/tests/

# Local agent/CI test run logs and scratch (see test-runs-output-directory.mdc)
test_runs/

# Pytest entrypoints outside tests/ directories
conftest.py
**/conftest.py

# Shell regression scripts (scripts/rebuild_*.sh remain — those are deploy tools)
scripts/test_*.sh

# Frontend unit/a11y/playwright sources (Vitest; not part of next build output)
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/test-utils/
**/test-fixtures/
hpcperfstats/site/frontend/test/
hpcperfstats/site/frontend/vitest.config.ts
hpcperfstats/site/frontend/scripts/fix-tests-next.mjs
hpcperfstats/site/frontend/README.md

# ---------------------------------------------------------------------------
# Agent, docs, and local dev-only files (not runtime in container image).
# ---------------------------------------------------------------------------

# Cursor agent rules (.cursor/ excluded above)
hpcperfstats/cursor-rules/
cursor-hooks/
**/*.mdc

# Operator / design docs (root README.md kept for setuptools metadata)
docs/

# Compose manifests (built on host; not baked into image layers)
docker-compose*.yaml
docker-compose*.yaml.example

# Pipeline rebuild staging (rebuild_pipeline.sh populates before --target refresh).
# Keep the staging tree out of normal contexts, but allow the preserve dir used by
# Dockerfile target hpcperfstats-pipeline-refresh (COPY .build/pipeline-rebuild-frontend/).
.build/
!.build/pipeline-rebuild-frontend/
!.build/pipeline-rebuild-frontend/**

# CI workflows and local analysis artifacts
.github/
artifacts/

# Host collectstatic tree when not using compose volume
staticfiles/

# macOS metadata
.DS_Store
**/.DS_Store
