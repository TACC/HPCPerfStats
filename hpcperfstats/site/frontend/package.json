{
  "name": "hpcperfstats-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "generate:api": "orval",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:api && next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "build:with-bokeh-playwright-smoke": "next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "start": "next start",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bokeh/bokehjs": "3.9.1",
    "@fontsource/open-sans": "^5.2.7",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.80.7",
    "bootstrap": "^5.3.8",
    "bootswatch": "^5.3.8",
    "next": "^15.3.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.57.0",
    "react-paginate": "^8.3.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "orval": "^7.9.0",
    "sass": "^1.100.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
