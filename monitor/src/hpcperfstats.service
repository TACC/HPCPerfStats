[Unit]
Description=Job-level Monitoring Service
# Ordering only: a no-op where XPU Manager is not installed (no Wants=, never starts it).
After=xpum.service

[Service]
Type=simple
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/hpcperfstats /run
# xpumcli (intel_gpu, PVC) talks to xpumd through these sockets in the host /tmp, which
# PrivateTmp hides; "-" skips nodes without XPU Manager. Bound at start: a later xpumd
# restart that recreates them needs a monitor restart too.
BindPaths=-/tmp/xpum_p.sock -/tmp/xpum_up.sock
# xpum.service (Type=simple) creates the sockets ~10 s after it reports started, so wait for
# them (host /tmp: "+" skips the sandbox) before BindPaths is applied to ExecStart. Returns at
# once when xpum.service is not active, gives up after 60 s, and never fails the start.
ExecStartPre=+/bin/sh -c 'systemctl -q is-active xpum.service || exit 0; i=0; while [ "$$i" -lt 60 ]; do [ -S /tmp/xpum_p.sock ] && [ -S /tmp/xpum_up.sock ] && exit 0; sleep 1; i=$$((i + 1)); done; exit 0'
# Default per-process soft FD limit is often 1024; collectors (one perf fd per event per CPU) + dumpfiles can exceed it (EMFILE).
LimitNOFILE=1048576
EnvironmentFile=-/etc/sysconfig/hpcperfstatsd
# Prefer stub lshw on PATH for bare `lshw` callers (harmless; not DCGM enforcement).
Environment=PATH=/usr/libexec/hpcperfstats/stubs:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
# libdcgm serial discovery execs absolute /usr/bin/lshw then /usr/sbin/lshw with a
# minimal env, so PATH cannot intercept it. Bind the no-op stub over both paths in
# this unit's mount namespace only (no host-visible change) to keep real lshw from
# probing empty-cage mlx module EEPROM (mlx5_query_module_id / query_mcia_reg 0x3).
BindReadOnlyPaths=-/usr/libexec/hpcperfstats/stubs/lshw:/usr/bin/lshw
BindReadOnlyPaths=-/usr/libexec/hpcperfstats/stubs/lshw:/usr/sbin/lshw
# Keep monitoring overhead off user-critical cores by default where admins set affinity.
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
ExecStart=/usr/sbin/hpcperfstatsd -c CONFIGFILE
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
