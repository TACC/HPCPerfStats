{
  "name": "hpcperfstats-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "write-site-identity": "node scripts/write-site-identity.mjs",
    "predev": "npm run write-site-identity",
    "dev": "next dev",
    "generate:api": "orval --project hpcperfstatsZod && orval --project hpcperfstats",
    "prebuild": "npm run write-site-identity",
    "pretypecheck": "npm run write-site-identity",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:dead": "knip",
    "build": "npm run generate:api && next build && node scripts/copy-next-export.mjs && node scripts/generate-robots-txt.mjs",
    "start": "next start",
    "pretest": "npm run write-site-identity",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bokeh/bokehjs": "3.9.1",
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "^16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@orval/zod": "^8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6",
    "orval": "^8",
    "typescript": "^6",
    "vite": "^8",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.16"
  }
}
