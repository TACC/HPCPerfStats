# Copy to hpcperfstats.ini — see README Installation (cp hpcperfstats.ini.example hpcperfstats.ini).

[DEFAULT]
# Short cluster name (used in RMQ queue and host_name_ext interpolation).
machine = cluster_name

# FQDN suffix for node dirs under archive_dir (dirname must end with this string).
host_name_ext = %(machine)s.domain.edu

# Root directory for HPCPerfStats file data (archive, accounting, logs).
data_dir = /hpcperfstats/

# Comma-separated FQDNs for the web/proxy host (TLS allowlist and Django ALLOWED_HOSTS).
server = servername.domain.edu, stats.cluster.domain.edu

# Queue name substrings that exclude jobs from listings (Python list syntax).
restricted_queue_keywords = ['secure', 'secret']

# Verbose logging in container logs (yes/true/1 or no).
debug = True

# Email domain suffix marking staff users who can see all jobs.
staff_email_domain = lab.hpcisgreat.edu

# IANA timezone for Django and cluster time alignment.
timezone = America/Chicago

# Django SECRET_KEY; set a long random value in production.
secret_key = change-me-to-a-long-random-string

# Ini cap on parallel workers (effective cores = min(this, os.cpu_count()); default 40).
total_cores = 40

# Django database engine backend.
engine_name = django.db.backends.postgresql

# PostgreSQL database name.
dbname = hpcperfstats

# PostgreSQL username.
username = hpcperfstats

# PostgreSQL password.
password = hpcperfstats

# PostgreSQL host (compose service name in default install).
host = db

# PostgreSQL port.
port = 5432

# Minimum total_cores before auto NUMA pinning in compose (default 32).
# cpuset_pin_min_total_cores = 32

# Minimum cores per node for auto NUMA pinning (default 16).
# cpuset_pin_min_cores_per_node = 16

# Max NUMA nodes for auto pin without explicit ids (default 16).
# numa_pin_max_nodes_auto = 16

# Also pin proxy container to web NUMA node (default no).
# pin_proxy_in_compose = no

# Explicit sysfs NUMA node id for web+proxy when set.
# web_numa_node =

# Explicit sysfs NUMA node id for pipeline when set.
# pipeline_numa_node =

[OAUTH2]
# OAuth2 client id from your identity provider.
client_id =

# OAuth2 client secret.
client_key =

# Tenant base URL for token and API calls.
oauth_base_url = https://tacc.tapis.io/v3

# Browser authorization URL template (uses client_id and redirect placeholders).
authorize_url = %(oauth_base_url)s/oauth2/authorize?client_id=%(client_id)s&redirect_uri=%%s&response_type=code&state=%%s

[RMQ]
# RabbitMQ hostname (compose service name in default install).
rmq_server = rabbitmq

# Queue name for monitor payloads (interpolates machine).
rmq_queue = %(machine)s

[SYSLOG]
# Comma-separated IPv4 CIDRs allowed on port 514; empty allows all IPv4.
# allow_from = 10.0.0.0/8, 192.168.50.0/24

# Listen for remote syslog on TCP 514 (default yes).
# listen_tcp = yes

# Listen for remote syslog on UDP 514 (default yes).
# listen_udp = yes

[PORTAL]
# http or https for CORS origins built from server when debug is off (default https).
# cors_origin_scheme = https

# Upper bound for Gunicorn workers when WEB_CONCURRENCY is unset (default 32).
# max_gunicorn_workers = 32

# Max threads for API prefetch and default small executor (default 4).
# parallel_db_prefetch_max = 4

# Override API ThreadPoolExecutor size; else parallel_db_prefetch_max (default 4).
# api_small_executor_max_workers = 4

# Django CONN_MAX_AGE seconds; env DJANGO_CONN_MAX_AGE overrides (default 90).
# db_conn_max_age = 90

# PostgreSQL statement_timeout ms per session; 0 omits (default 120000).
# db_statement_timeout_ms = 120000

# PostgreSQL idle_in_transaction_session_timeout ms; 0 omits (default 300000).
# db_idle_in_transaction_session_timeout_ms = 300000

[PIPELINE]
# Directory for Slurm accounting logs.
acct_path = %(data_dir)s/accounting

# Per-host raw stats tree; subdir names must end with host_name_ext.
archive_dir = %(data_dir)s/archive

# Daily sealed monitor archive directory.
daily_archive_dir = %(data_dir)s/daily_archive

# Pipeline overlap: balanced or ingest_priority (default balanced).
# pipeline_overlap_mode = balanced

# Cap on update_metrics multiprocessing pool size (default 32).
# metrics_pool_process_cap = 32

# Metrics pool scale during ingest_priority overlap (default 0.75).
# metrics_ingest_priority_scale = 0.75

# Minimum metrics processes under ingest_priority (default 1).
# metrics_min_processes = 1

# Metrics scheduler: strict_date, global_fifo, or global_priority (default global_priority).
# metrics_scheduler_mode = global_priority

# Prefetch chunk descriptors for global scheduler (default 8).
# metrics_scheduler_prefetch_chunks = 8

# Ready-jid queue depth target before compute (default 2000).
# metrics_scheduler_ready_queue_target = 2000

# Plot prewarm: inline or pipeline_required (default pipeline_required).
# metrics_plot_prewarm_mode = pipeline_required

# Skip job detail/plot prewarm after metrics for catch-up (default no).
# metrics_scheduler_skip_prewarm = no

# Thread workers for plot prewarm stage (default 4).
# metrics_prewarm_workers = 4

# Max queued async prewarm jobs before backpressure (default 32).
# metrics_prewarm_backlog_cap = 32

# Seconds to wait for async prewarm slot before inline fallback (default 0.25).
# metrics_prewarm_backpressure_wait_s = 0.25

# Base seconds to drain prewarm after each metrics batch (default 2.0).
# metrics_prewarm_drain_batch_budget_s = 2.0

# Ceiling for scaled prewarm drain budget seconds (default 60).
# metrics_prewarm_drain_batch_budget_max_s = 60

# Extra drain seconds per successful jid in batch (default 0.5).
# metrics_prewarm_drain_per_job_s = 0.5

# Prewarm retry attempts per plot task (default 2).
# metrics_prewarm_retry_attempts = 2

# Threads for concurrent per-jid metrics+prewarm in scheduler (default 4).
# metrics_scheduler_compute_threads = 4

# imap_unordered poll timeout in Metrics.run seconds (default 5).
# metrics_run_poll_timeout_s = 5

# Max no-progress seconds in Metrics.run before abort (default 900).
# metrics_run_stall_timeout_s = 900

# Per-job compute wall clock in pool workers; 0 uses metrics_run_stall_timeout_s (default 0).
# metrics_run_per_job_timeout_s = 0

# statement_timeout ms for metrics persistence (default 120000).
# metrics_persist_statement_timeout_ms = 120000

# lock_timeout ms for metrics persistence (default 10000).
# metrics_persist_lock_timeout_ms = 10000

# Max jids per proxy host_data readiness batch on PostgreSQL (default 48).
# metrics_proxy_reject_jid_batch_size = 48

# Max sum of job window seconds per compute batch; 0 disables (default 0).
# metrics_compute_batch_max_window_s = 0

# Max seconds for one job in a batch; 0 disables (default 0).
# metrics_compute_batch_max_single_job_s = 0

# Assumed window seconds when job times unknown (default 172800).
# metrics_compute_batch_unknown_runtime_s = 172800

# Watchdog on metrics phase wall time per batch seconds (default 120).
# metrics_compute_watchdog_s = 120

# Watchdog on full batch wall; 0 uses metrics-only watchdog (default 0).
# metrics_compute_total_watchdog_s = 0

# Retry interval for deferred not-ready jids seconds (default 10).
# metrics_deferred_not_ready_retry_s = 10

# Max retries for deferred not-ready jids (default 30).
# metrics_deferred_not_ready_max_retries = 30

# Max age before giving up on deferred jid seconds (default 900).
# metrics_deferred_not_ready_max_age_s = 900

# Quarantine time for repeatedly deferred jid seconds (default 300).
# metrics_deferred_not_ready_quarantine_s = 300

# Defer update_metrics until in-window host_data samples exist within margins of
# Slurm start and end (job aggregate, any accounting host). Default yes.
# metrics_readiness_require_window_coverage = yes

# Start edge tolerance seconds (default 600): MIN(time) in window must be <= start + margin.
# metrics_readiness_start_margin_seconds = 600

# End edge tolerance seconds (default 600): MAX(time) in window must be >= end - margin.
# metrics_readiness_end_margin_seconds = 600

# Cap sync_timedb ingest pool processes and archive metadata discovery threads
# (head + sampled DB-gate scans on the janitor thread; default 8 on 128 GiB cgroup hosts).
sync_pool_process_cap = 8

# Cap sync_timedb archive pool processes when set.
# archive_pool_process_cap =

# Max concurrent sealed-day streams for sync_timedb_archive backfill (default 1).
# sync_timedb_archive_max_concurrent_sealed_days = 1

# Enable cpuset-aware S/A/M budget for sync and metrics (default yes).
# sync_enable_cpuset_priority_budget = yes

# Fraction of effective cores for sync ingest cap (default 0.60).
# sync_budget_ingest_ratio = 0.60

# Fraction for sync archive cap (default 0.15).
# sync_budget_archive_ratio = 0.15

# Fraction for metrics cap (default 0.20).
# sync_budget_metrics_ratio = 0.20

# Reserve fraction for maintenance jitter (default 0.05).
# sync_budget_reserve_ratio = 0.05

# Minimum metrics percent floor (default 10).
# sync_budget_min_metrics_percent = 10

# Minimum archive percent floor (default 10).
# sync_budget_min_archive_percent = 10

# Bounded overprovision mode for budget derivation (default no).
# sync_enable_overprovision_mode = no

# Overcommit factor for S+A+M+R cap (default 1.00).
# sync_budget_overcommit_factor = 1.00

# Ingest multiplier when overprovision on (default 1.00).
# sync_overprovision_ingest_multiplier = 1.00

# Archive multiplier when overprovision on (default 1.00).
# sync_overprovision_archive_multiplier = 1.00

# Metrics multiplier when overprovision on (default 1.00).
# sync_overprovision_metrics_multiplier = 1.00

# Max in-memory ingest work queue size (default 2000).
# sync_ingest_queue_max_size = 2000

# Max in-memory archive work queue size (default 1000).
# sync_archive_queue_max_size = 1000

# Archive task retries before dead-letter behavior (default 5).
# sync_archive_retry_max_attempts = 5

# Base archive retry backoff seconds (default 1).
# sync_archive_retry_backoff_base_seconds = 1

# Max archive retry backoff seconds (default 60).
# sync_archive_retry_backoff_max_seconds = 60

# Processed-file checkpoint writes per batch (default 100).
# sync_checkpoint_flush_batch_size = 100

# host_data/proc_data bulk_create batch size and incremental parse flush threshold (default 10000).
# Also drives archive DB gate sample stride (batch_size // 2 timestamp lines, plus last line at EOF).
# sync_bulk_create_batch_size = 10000

# Max DB timestamps cached per duplicate-detection window (default 100000).
# sync_host_itimes_cache_max_timestamps_per_entry = 20000

# Poll interval for sync_timedb pool waits seconds (default 5).
# sync_pool_poll_timeout_s = 5

# Maximum consecutive pool poll timeouts before exit 124 (ceiling 2881 x 5s ≈ 14405s).
# Per-batch abort is computed from the largest file in the current imap sub-batch (floor .. ceiling).
# sync_pool_stall_abort_after_timeouts = 2881

# Polls to tolerate maxtasksperchild worker recycle before exit 137 (default 2).
# sync_pool_worker_recycle_grace_polls = 2

# Per ingest pool task wall-clock floor seconds; 0 disables all per-file timeouts (default 900).
# sync_ingest_per_file_timeout_s = 900

# Size-proportional ingest timeout: resolved = clamp(floor + ceil_mib(size) * per_mib, floor, max).
# Default per_mib (13500/5120) maps 5 GiB to max; larger files cap at max (no file-size reject).
# sync_ingest_per_file_timeout_s_per_mib = 2.63671875

# Ceiling seconds for size-proportional per-file ingest timeout (default 14400 = 4h).
# sync_ingest_per_file_timeout_max_s = 14400

# Cache daily tar member maps per worker on DB-complete ingest checks (default yes).
# sync_archive_members_cache_enabled = yes

# Max cached daily archive member maps per ingest/archive worker (default 64).
# sync_archive_members_cache_max_entries = 64

# Cross-worker Redis L2 for daily archive member maps (default yes; hard-fail when enabled).
# sync_archive_members_redis_enabled = yes

# Redis TTL seconds for member HASH / complete keys (default 86400).
# sync_archive_members_redis_ttl_seconds = 86400

# Populate lock lease seconds; renewed during winner scan (default 3600).
# sync_archive_members_redis_populate_lock_seconds = 3600

# Waiter abort when populate shows no HASH/lock-renewal progress (default 120).
# sync_archive_members_redis_populate_stall_seconds = 120

# Absolute cap for populate/waiter loops; 0 disables (default 7200).
# sync_archive_members_redis_populate_max_seconds = 7200

# Waiter poll interval seconds for incremental member lookups (default 0.25).
# sync_archive_members_redis_wait_poll_seconds = 0.25

# HSET pipeline batch size during winner populate scan (default 500).
# sync_archive_members_redis_hset_batch_size = 500

# Refuse populate when estimated Redis HASH payload exceeds this many bytes (default 8388608).
# sync_archive_members_redis_max_payload_bytes = 8388608

# Write-lock shard count for sync ingest; auto if unset.
# sync_write_lock_shards =

# Parse-worker to DB-writer queue pipeline (default no).
# sync_enable_db_writer_pipeline = no

# Parse+write in one ingest worker; no parent DataFrame staging (default no).
# sync_db_writer_combined_task = no

# Max parse payloads staged before db-writer drain when split pipeline (default 8).
# sync_db_writer_stage_max_batch = 8

# Stats files per ingest chunk (default 1000).
# sync_ingest_chunk_size = 1000

# Supervisor RSS limit MiB; 0 disables fail-fast exit (default 0).
# sync_supervisor_rss_limit_mb = 0

# Check supervisor RSS every N ingest chunks (default 1).
# sync_supervisor_rss_check_every_n_chunks = 1

# Process-tree RSS defer limit MiB (supervisor + pool workers); 0 off (default 96000).
sync_process_tree_rss_limit_mb = 96000

# Check process-tree RSS every N ingest chunks (default 1).
# sync_process_tree_rss_check_every_n_chunks = 1

# Hard exit when process-tree RSS exceeds MiB; 0 off (default 0).
# sync_process_tree_rss_exit_mb = 0

# Max stats file size for readlines fast path; larger files stream-parse (default 512 MiB).
# sync_ingest_max_file_read_bytes = 536870912

# Route duplicate scan through streaming path above this size (default 8 MiB).
# sync_ingest_stream_duplicate_scan_bytes = 8388608

# Tail timestamp lines probed before full duplicate scan on large head-present files (default 500).
# sync_ingest_db_complete_tail_window_lines = 500

# Max concurrent imap tasks per chunk; 0 means pool size (default 0).
# sync_ingest_imap_inflight_cap = 0

# Recycle ingest/archive pool workers after N files; 0 unlimited (default 1).
sync_ingest_pool_maxtasksperchild = 1

# Return freed worker heap to OS after each ingest task on Linux (default yes).
sync_ingest_malloc_trim_after_file = yes

# Optional global seal concurrency cap; 0 unlimited (default 0).
# sync_cold_path_max_concurrent_seals = 0

# DB-writer pool size as fraction of ingest pool (default 0.80).
# sync_db_writer_pool_multiplier = 0.80

# Hard cap on DB-writer pool processes when set.
# sync_db_writer_pool_cap =

# Adaptive burst dispatch for sync queues (default yes).
# sync_adaptive_dispatch_enabled = yes

# Dispatch burst factor (default 2.0).
# sync_dispatch_burst_factor = 2.0

# Archive dispatch backoff ratio (default 0.50).
# sync_dispatch_archive_backoff_ratio = 0.50

# Dispatch step size (default 8).
# sync_dispatch_step_size = 8

# Ingest-first durability semantics: checkpoint after DB even if append fails (default yes).
# sync_enable_ingest_first_durability_mode = yes

# Archive DB gate depth: head = first timestamp only; sample = strided lines + EOF last.
# sync_archive_db_ingest_gate_mode = head

# Require DB ingest readiness before tar append or raw delete (default yes).
# When yes, gate depth follows sync_archive_db_ingest_gate_mode (sample stride =
# sync_bulk_create_batch_size // 2 plus last timestamp line at EOF).
# sync_archive_require_db_head_ingest = yes

# Persist archive maintenance hints for faster restarts (default yes).
# sync_archive_maint_hints = yes

# Keep uncompressed YYYY-MM-DD.tar after sealing globally (default no).
# Prior days drop at seal when raw is gone; calendar-today uses grace hours below.
# archive_keep_uncompressed_tar = no

# Hours after local midnight to retain today's uncompressed .tar when global keep is off (default 8).
# archive_today_uncompressed_tar_grace_hours = 8

# Seconds idle before sealing today's tar; prior days seal immediately (default 60).
# archive_seal_idle_seconds = 60

# zstd -T thread count for seal and decompress; 0 uses -T0 (all cores per job, default).
# archive_zstd_threads = 0

# Added nice for archive zstd subprocesses; 0 disables (default 10).
# archive_zstd_nice = 10

# ionice class for archive zstd: 0=none, 2=best-effort, 3=idle (default 2).
# archive_zstd_ionice_class = 2

# ionice level within class for archive zstd, 0-7 (default 6).
# archive_zstd_ionice_level = 6

# Max concurrent daily tar seals during maintenance (default 4).
# archive_seal_parallel_workers = 4

# zstd compression level 1-19 for .tar.zst (default 7; benchmark before raising above 9).
# archive_zstd_level = 7

# Linux-only: posix_fadvise SEQUENTIAL/DONTNEED around archive zstd subprocess I/O to
# encourage early page-cache eviction after one-shot seal/decompress/integrity reads.
# Default yes when omitted; set no only for A/B tuning or debugging.
# archive_zstd_drop_page_cache = yes

# Deprecated: ignored by sync_timedb (day-close runs at startup + every rescan_every_chunks).
# archive_maintenance_interval_seconds = 28800

# Max seconds to defer scheduled maintenance while archive append is in flight (legacy; default 3600).
# archive_maintenance_max_defer_seconds = 3600

# Optional idle dwell before janitor tick budget bonus (default 300).
# archive_maintenance_idle_seconds = 300

# Archive janitor micro-batch wall budget per tick seconds (default 30).
# archive_janitor_budget_seconds = 30

# Max distinct calendar days (DAY_CLOSE pipeline) per janitor tick (default 2).
# archive_janitor_days_per_tick = 2

# Debt queue depth before temporary burst scaling (default 50).
# archive_janitor_debt_high_watermark = 50

# Budget multiplier when debt exceeds high watermark (default 1.5).
# archive_janitor_debt_burst_factor = 1.5

# Cap in-memory janitor debt queue entries (default 200).
# archive_janitor_debt_max_entries = 200

# Max raw stats file deletes per janitor RAW_REMOVE debt item per tick (default 1000).
# archive_janitor_raw_paths_per_tick = 1000

# Startup async verify + gated delete for sealed archived raw (default yes).
# sync_startup_raw_removal_preflight = yes

# Wall-clock budget per startup raw-removal verification slice (default 60 seconds).
# sync_startup_raw_removal_verify_budget_seconds = 60

# Max calendar days verified per startup raw-removal slice (default 5).
# sync_startup_raw_removal_verify_days_per_slice = 5

# Max deletes per gated startup delete pass; 0 = unlimited during delete window (default 0).
# sync_startup_raw_removal_max_deletes_per_pass = 0

# Block first ingest until startup day-close discover and deletion drain idle (default yes).
# sync_startup_drain_day_close_before_ingest = yes

# During startup drain, ingest checkpoint-blocked tail paths per day (default yes).
# sync_startup_tail_ingest_enabled = yes

# Max on-disk unprocessed paths per day for startup tail ingest (default 100).
# sync_startup_tail_ingest_max_files = 100

# Startup checkpoint-driven async DAY_CLOSE for ingest-complete calendar days (default yes).
# sync_startup_day_close_preflight = yes

# Wall-clock budget per startup day-close discover slice (default 300 seconds).
# sync_startup_day_close_budget_seconds = 300

# Max calendar days submitted per startup day-close slice (default = startup max inflight).
# sync_startup_day_close_days_per_slice = 4

# Max concurrent async DAY_CLOSE during startup drain (default = archive_seal_parallel_workers).
# sync_startup_day_close_max_inflight = 4

# Max wait for canonical startup archive snapshot before single-flight build (default 300s; min 120).
# sync_startup_snapshot_wait_seconds = 300

# Optional warn threshold when startup day-close scan phase is slow (0 = disabled).
# sync_startup_day_close_scan_budget_seconds = 0

# Async DAY_CLOSE worker threads (default 1).
# sync_day_close_async_workers = 1

# Max concurrent async DAY_CLOSE jobs (default = sync_day_close_async_workers).
# sync_day_close_max_inflight = 1

# Wall-clock wait in async DAY_CLOSE for day raw removal verify after seal (default 3600s; 0 = unbounded).
# sync_day_close_raw_removal_wait_seconds = 3600

# Recover stale async DAY_CLOSE manifest entries on coordinator init (default 7200s; 0 = off).
# sync_day_close_async_stale_seconds = 7200

# Sleep between startup day-close discover slices when async pool saturated (default 30s).
# sync_startup_day_close_backoff_seconds = 30

# Log day-close candidate report (queued/disqualified only; default yes).
# sync_day_close_candidate_report = yes

# Per-day async verify+delete pipeline after DAY_CLOSE seal (default yes). DAY_CLOSE debt
# is scheduled at supervisor startup and every rescan_every_chunks ingest chunks (default 10).
# sync_day_close_raw_removal_preflight = yes

# Wall-clock budget for day-close verify slices in the async pipeline (default 30 seconds).
# sync_day_close_raw_removal_verify_budget_seconds = 30

# Max deletes per day-close delete loop iteration; 0 = unlimited per iteration (default 0).
# sync_day_close_raw_removal_max_deletes_per_pass = 0

# Deprecated: unparsable closed raw is quarantined at ingest parse failure (default 50, unused).
# sync_unparsable_raw_quarantine_max_per_tick = 50

# Max concurrent disjoint daily-tar archive append jobs (default 2).
# sync_archive_max_inflight_jobs = 2

# Seconds before logging an archive pool job as stalled (default 600).
# sync_archive_worker_stall_seconds = 600

[CACHE]
# Redis URL for Django cache (compose default uses redis service).
redis_location = redis://redis:6379/1

[XALT]
# XALT database engine when XALT integration is enabled.
xalt_engine =

# XALT database name.
xalt_name =

# XALT database user.
xalt_user =

# XALT database password.
xalt_password =

# XALT database host.
xalt_host =
