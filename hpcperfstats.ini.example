# The RMQ and Portal sections have been configured to work for the docker installation. You will only need to edit the Default section and the host_name_ext variable under the Portal section, and we recommend editing just these and performing the installation using our instructions. If you need to edit some variables, please note that a lot of them are tied to the docker yml file.

[DEFAULT]
# Short name of your cluster i.e. frontera
machine		          = cluster_name

# FQDN suffix for cluster nodes (short-host.FQDN). sync_timedb and archive layout
# use this: under archive_dir, only immediate subdirs whose names *end with* this
# string (e.g. c123.frontera.tacc.utexas.edu when host_name_ext is frontera.tacc.utexas.edu) are scanned for stats files.
host_name_ext      = %(machine)s.domain.edu

# Path you would like all of HPCPerfStats' data to be stored. It will be the central location where all the file operations occur.
data_dir 	          = /hpcperfstats/

# FQDN for the web server host, split with commas if multiple
server 		          = servername.domain.edu, stats.cluster.domain.edu

# Keywords from queues which should be ignored
restricted_queue_keywords = ['secure', 'secret']

# Debug Output in the docker logs
debug                 = True

# This is used to determine if a user (presumably a staff member) can see all jobs
staff_email_domain   = lab.hpcisgreat.edu

# The cluster and docker host need to share this timezone.
# The timezone must come from this list:
# http://en.wikipedia.org/wiki/List_of_tz_zones_by_name
timezone = America/Chicago

# Total amount of cores that are available for this application (omit to default to 40).
total_cores = 40

# Concurrency caps (optional; see docs/DEPLOY_CONCURRENCY_AND_NUMA.md)
# max_gunicorn_workers = 32
# metrics_pool_process_cap = 32
# api_small_executor_max_workers = 8
# cpuset_pin_min_total_cores = 32
# cpuset_pin_min_cores_per_node = 16
# numa_pin_max_nodes_auto = 16
# pin_proxy_in_compose = no
# web_numa_node =
# pipeline_numa_node =

# Django SECRET_KEY (do not commit real keys; set in ini or env for production)
secret_key = change-me-to-a-long-random-string

[OAUTH2]
# oauth client id
client_id =

# oauth secret key
client_key =

# Base OAUTH URL
oauth_base_url = https://tacc.tapis.io/v3

# URL for authorization
authorize_url     = %(oauth_base_url)s/oauth2/authorize?client_id=%(client_id)s&redirect_uri=%%s&response_type=code&state=%%s


[RMQ]
# Rabbit MQ server (pre-configured for container installation)
rmq_server 	       = rabbitmq

# Rabbit MQ queue (pre-configured for container installation)
rmq_queue 	       = %(machine)s


[PORTAL]
# Path where all of the slurm logs for job accounting data will be stored (pre-configured for container installation)
acct_path          = %(data_dir)s/accounting

# Raw node stats: one subdirectory per host; dirname must end with DEFAULT.host_name_ext
archive_dir	       = %(data_dir)s/archive



# Name of the postgres database (pre-configured for container installation)
dbname             = hpcperfstats

# Path where all of the aggregate, raw Rabbit MQ data is stored, which can be used to potentially recreate the database. (pre-configured for container installation)
daily_archive_dir  = %(data_dir)s/daily_archive

# Deferred compression: sync_timedb appends to YYYY-MM-DD.tar; pigz seal + removal
# of verified raw stats run on archive_pigz_interval_seconds (default 4 hours).
# Keep yes unless you accept re-decompressing on every append for that day.
# archive_keep_uncompressed_tar = yes
# archive_seal_idle_seconds = 60
# archive_pigz_level = 8
# archive_pigz_interval_seconds = 14400

# Django engine backend (pre-configured for container installation)
engine_name        = django.db.backends.postgresql 

# Postgres username (pre-configured for container installation)
username           = hpcperfstats

# Postgres password (pre-configured for container installation)
password           = hpcperfstats

# Database host (pre-configured for container installation)
host               = db

# Database port (pre-configured for container installation)
port               = 5432


[CACHE]
# Redis URL for ORM/view caching (e.g. redis://host:port/db)
redis_location = redis://redis:6379/1

[XALT]
# Name of XALT engine
xalt_engine        = 

# XALT name
xalt_name          =

# XALT username
xalt_user          =

# XALT password
xalt_password      =

# XALT host
xalt_host          =
