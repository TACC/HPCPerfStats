+/// HPCPerfStats local delta: PR #860 skips threading._active on 3.14t.
+/// Label FT threads from Linux task comm (15-char setthreadtitle surface).
+#[cfg(target_os = "linux")]
+fn linux_comm_thread_names(pid: remoteprocess::Pid) -> Option<HashMap<u64, String>> {
+    use std::fs;
+    let mut names = HashMap::new();
+    let task_dir = format!("/proc/{}/task", pid);
+    let entries = fs::read_dir(task_dir).ok()?;
+    for entry in entries.flatten() {
+        let Ok(tid) = entry.file_name().to_string_lossy().parse::<u64>() else {
+            continue;
+        };
+        if let Ok(comm) = fs::read_to_string(entry.path().join("comm")) {
+            names.insert(tid, comm.trim_end().to_string());
+        }
+    }
+    if names.is_empty() {
+        None
+    } else {
+        Some(names)
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+fn linux_comm_thread_names(_pid: remoteprocess::Pid) -> Option<HashMap<u64, String>> {
+    None
+}
